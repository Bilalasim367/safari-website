# Safari Perfumes - MySQL Database (cPanel / Local)
# Copy this file to .env and fill in real values. Do NOT commit .env files.

# MySQL Database (cPanel format)
# Format: mysql://<db_user>:<db_password>@<host>:<port>/<db_name>
DATABASE_URL="mysql://cpanel_user:password@localhost:3306/db_name"

# For remote MySQL (if not localhost), use the cPanel-provided host:
# DATABASE_URL="mysql://cpanel_user:password@cpanel_host:3306/db_name"

# Next.js
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
# Empty = same-origin API calls (correct for cPanel single-domain hosting)
NEXT_PUBLIC_API_URL=

# Auth (JWT) - use a strong random secret of at least 32 chars
JWT_SECRET="your-jwt-secret-min-32-chars"
ADMIN_SECRET_KEY="your-admin-secret-key"

# Optional: image uploads (Vercel Blob / cloud storage - works from any host)
# BLOB_READ_WRITE_TOKEN="your-blob-token"
